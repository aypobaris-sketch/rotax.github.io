{
  "env": {
    "MCP_TIMEOUT": "300000"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cbm-session-start.sh\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cbm-session-start.sh\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cbm-session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
